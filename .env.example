# Copy this file to .env and fill in your own key. .env is gitignored and
# never committed; this .example file is, so the required variable name
# stays documented without ever holding a real secret.

# Required for Creative Lab's live creative-generation step
# (agents/creative_studio/image_provider.py). Without it, "Generate
# creative" stays disabled with an explanation instead of failing, unless
# CREATIVE_GENERATION_MODE=demo (the default), which needs no key at all.
OPENAI_API_KEY=

# "demo" (default) or "live". Controls whether "Generate Creatives"
# resolves pre-generated fixture images (agents/creative_studio/
# demo_assets.py, zero provider calls, no API key needed) or makes a real
# OpenAI call via OPENAI_API_KEY above. Leave unset/at "demo" for local
# development and the interview demo; set to "live" only to deliberately
# exercise or add to the real generation path. Never exposed as a
# Streamlit UI control: this is an application/development setting, not
# something a marketer chooses.
CREATIVE_GENERATION_MODE=demo
